# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Force bash shell scripts to LF
*.sh text eol=lf

# Force Windows scripts to CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary defaults
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
*.pkl binary
*.joblib binary
*.h5 binary
*.keras binary
*.pt binary

# Linguist overrides (GitHub language stats)
docs/* linguist-documentation
notebooks/* linguist-notebook
